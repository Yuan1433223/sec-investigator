# ==================== App ====================
ENV=dev
DEBUG=false
LOG_LEVEL=INFO

# ==================== Data source ====================
# fake (default): run fully offline against synthetic fixtures derived from the
#   recorded incidents — no enterprise ES/Prometheus/WAF/GF needed, no VPN.
# real: reach the configured enterprise endpoints below (requires VPN + creds).
DATA_SOURCE=fake

# ==================== LLM ====================
# Provider: "openai" or "anthropic"
LLM_PROVIDER=anthropic

# Anthropic (direct or relay endpoint)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL_NAME=claude-sonnet-4-6
CLAUDE_FLASH_MODEL_NAME=claude-sonnet-4-6

# OpenAI-compatible (Dashscope / vLLM / Ollama etc.)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
PLUS_MODEL_NAME=gpt-4o
FLASH_MODEL_NAME=gpt-4o-mini

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sec-investigator

# ==================== Storage ====================
SQLITE_PATH=./sec_investigator.db
POSTGRES_DSN=postgresql://localhost/kks

# ==================== Elasticsearch ====================
# Placeholder hosts — ignored entirely when DATA_SOURCE=fake; only used in "real".
ES_URL=https://es.example.internal:9200
ES_USERNAME=
ES_PASSWORD=
ES_WAF_INDEX=waf_full_log*
ES_GF_INDEX=gamedun-full-logs*
ES_ALARM_INDEX=security_analysis_alarm*

# ==================== Prometheus ====================
PROMETHEUS_URL=http://prom.example.internal:9090

# ==================== CC 检查 ====================
CC_API_URL=http://cc.example.internal
CC_API_KEY=

# ==================== DDoS 检查 ====================
DDOS_API_URL=http://ddos.example.internal
DDOS_API_KEY=
DDOS_TOKEN=

# ==================== WAF ====================
WAF_API_URL=http://waf.example.internal
WAF_API_TOKEN=

# ==================== 高防 (GF) ====================
GF_YXD_API_URL=http://gf-yxd.example.internal
GF_YXD_API_XTOKEN=

GF_CDN_API_URL=http://gf-cdn.example.internal
GF_CDN_API_XTOKEN=

GF_DDOS_API_URL=http://gf-ddos.example.internal
GF_DDOS_API_XTOKEN=

# ==================== 飞书 ====================
FEISHU_ALERT_WEBHOOK_URL=

# ==================== RAG ====================
MILVUS_HOST=localhost
MILVUS_PORT=19531
MILVUS_USER=root
MILVUS_PASSWORD=
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=
MONGODB_PASSWORD=
RAG_DEFAULT_TEAM_ID=
RAG_DEFAULT_DATASET_ID=
